<?php

namespace App\Models;

use BlockchainSdk\DTOs\TokenBalance;
use BlockchainSdk\DTOs\TransactionResult;
use BlockchainSdk\Laravel\Facades\Blockchain;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\HasMany;

class BlockchainSdkWallet extends Model
{
    protected $table = 'blockchainsdk_wallets';

    protected $guarded = [];

    protected $casts = [
        'private_key' => 'encrypted',
        'is_active'   => 'boolean',
    ];

    public function deposits(): HasMany
    {
        return $this->hasMany(BlockchainSdkDeposit::class, 'wallet_id');
    }

    public function sweeps(): HasMany
    {
        return $this->hasMany(BlockchainSdkSweep::class, 'wallet_id');
    }

    public static function createForUser(mixed $userId, string $network): self
    {
        $keypair = Blockchain::driver($network)->generateWallet();

        return self::create([
            'user_id'     => $userId,
            'network'     => strtolower($network),
            'address'     => $keypair->address,
            'private_key' => $keypair->privateKey,
            'public_key'  => $keypair->publicKey,
            'mnemonic'    => $keypair->mnemonic,
            'is_active'   => true,
        ]);
    }

    public function getBalance(?string $tokenContract = null): TokenBalance
    {
        return Blockchain::driver($this->network)->getBalance($this->address, $tokenContract);
    }

    public function sweep(?string $tokenContract = null, bool $sponsor = true): TransactionResult
    {
        $driver = Blockchain::driver($this->network);
        $masterVault = Blockchain::getMasterWallet($this->network);
        $gasKey = $sponsor ? Blockchain::getMasterGasKey($this->network) : null;

        if ($gasKey && $tokenContract) {
            return $driver->sweepTokenWithGasSponsorship(
                subWalletPrivateKey: $this->private_key,
                masterGasPrivateKey: $gasKey,
                toVaultAddress:      $masterVault,
                tokenContract:       $tokenContract
            );
        }

        return $driver->sweep($this->private_key, $masterVault, $tokenContract);
    }
}